# Copy this file to .env and fill in local values. Never commit real secrets.
APP_ENV=dev
DATABASE_URL=sqlite:///./data/docpilot.db
UPLOAD_DIR=./data/uploads
TASK_BACKEND=inline

# Keep mock for local development without a model service.
# For an OpenAI-compatible third-party relay, set these four values:
#   LLM_PROVIDER=openai_compatible
#   LLM_API_KEY=your-relay-key
#   LLM_BASE_URL=https://relay.example.com/v1
#   LLM_MODEL=the-model-name-supported-by-your-relay
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# This project uses lightweight local Chinese embeddings. Weights are downloaded on
# the first indexing request and then reused from the local Hugging Face cache.
# Use openai_compatible only when the relay exposes POST /v1/embeddings.
# EMBEDDING_API_KEY and EMBEDDING_BASE_URL fall back to LLM_* when left empty.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MIN_SCORE=0.25

RERANK_MODEL=
JWT_SECRET=change-me-in-development
# AUTH_REQUIRED=false is convenient for local development. Set true in a deployed Web service.
AUTH_REQUIRED=false
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=26214400
TASK_WORKERS=2
